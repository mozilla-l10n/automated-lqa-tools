# Secrets for local runs. Copy to `secrets.env` (git-ignored) and fill in
# what you need; leave the rest empty. A variable already set in the
# environment takes precedence, and CI uses repository secrets instead.
# Each script reads only the names it needs (lib/local_secrets.py).

# lib/run.py, lib/autosuggest.py, lib/pontoon_review.py (inferred reasons)
ANTHROPIC_API_KEY=

# Personal Access Token from your Pontoon settings.
# lib/suggest.py upload, lib/autosuggest.py --submit, lib/pontoon_review.py
PONTOON_TOKEN=

# lib/digest.py --send. For Gmail, an app password: the 16 letters, no spaces.
SMTP_USER=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
